<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name        "orphan.images">
<!ENTITY author      "wildfirebill">
<!ENTITY version     "2026.05.21">
<!ENTITY launch      "Settings/Docker Orphan Cleaner">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/wildfirebill-unraid/my_plugins/main/orphan_images/&name;.plg">
<!ENTITY pluginLOC   "/boot/config/plugins/&name;">
<!ENTITY emhttpLOC   "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        icon="trash"
        min="6.9.0"
        support="https://github.com/wildfirebill-unraid/my_plugins"
        project="https://github.com/wildfirebill-unraid/my_plugins"
>

<CHANGES>
### 2026.05.21
- Initial release
</CHANGES>

<!-- ============================================================ -->
<!--  default.cfg                                                  -->
<!-- ============================================================ -->
<FILE Name="&emhttpLOC;/default.cfg">
<INLINE><![CDATA[ORPHAN_DANGLING="yes"
ORPHAN_UNUSED="no"
ORPHAN_FORCE="no"
ORPHAN_LEAVE_TAGGED="no"
ORPHAN_SCHEDULE="daily"
ORPHAN_CRON_STRING=""
ORPHAN_LOG_RETENTION="7"
]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  cleanup.sh                                                   -->
<!-- ============================================================ -->
<FILE Name="&emhttpLOC;/cleanup.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
set -o pipefail

PLUGIN_NAME="orphan.images"
LOG_DIR="/var/log"
LOG_FILE="${LOG_DIR}/${PLUGIN_NAME}.log"
SETTINGS_FILE="/boot/config/plugins/${PLUGIN_NAME}/${PLUGIN_NAME}.cfg"

[[ -f "${SETTINGS_FILE}" ]] && source "${SETTINGS_FILE}" || :

ORPHAN_DANGLING="${ORPHAN_DANGLING:-yes}"
ORPHAN_UNUSED="${ORPHAN_UNUSED:-no}"
ORPHAN_FORCE="${ORPHAN_FORCE:-no}"
ORPHAN_LEAVE_TAGGED="${ORPHAN_LEAVE_TAGGED:-no}"
ORPHAN_LOG_RETENTION="${ORPHAN_LOG_RETENTION:-7}"

log() {
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  echo "${ts} $*" >> "${LOG_FILE}"
  echo "${ts} $*"
}

rotate_log() {
  local days="${1:-7}"
  [[ "${days}" -eq 0 ]] && return
  [[ ! -f "${LOG_FILE}" ]] && return
  local age=$(( ($(date +%s) - $(date +%s -r "${LOG_FILE}")) / 86400 ))
  [[ "${age}" -gt "${days}" ]] && mv -f "${LOG_FILE}" "${LOG_FILE}.old" 2>/dev/null || :
}

cleanup_dangling() {
  local ids
  ids="$(docker images --filter 'dangling=true' -q 2>/dev/null)"
  ids="$(echo "${ids}" | tr -d '[:space:]')"
  [[ -z "${ids}" ]] && { log "No dangling images."; return 0; }

  local count
  count="$(echo "${ids}" | wc -w)"
  log "Found ${count} dangling image(s)."
  local flags=""
  [[ "${ORPHAN_FORCE}" == "yes" ]] && flags="-f"
  local removed=0
  for id in ${ids}; do
    if docker rmi ${flags} "${id}" >> "${LOG_FILE}" 2>&1; then
      log "  Removed dangling: ${id}"
      removed=$((removed + 1))
    fi
  done
  log "Removed ${removed} dangling image(s)."
}

cleanup_unused() {
  local used_ids
  used_ids="$(docker ps -a --format '{{.ImageID}}' 2>/dev/null | sort -u)"
  local removed=0

  while IFS='|' read -r repo_tag img_id; do
    [[ "${repo_tag}" == "<none>:<none>" ]] && continue
    if [[ "${ORPHAN_LEAVE_TAGGED}" == "yes" ]] && [[ "${repo_tag}" != *"<none>"* ]]; then continue; fi
    if echo "${used_ids}" | grep -qF "${img_id}"; then continue; fi
    local flags=""
    [[ "${ORPHAN_FORCE}" == "yes" ]] && flags="-f"
    if docker rmi ${flags} "${img_id}" >> "${LOG_FILE}" 2>&1; then
      log "  Removed unused: ${repo_tag} (${img_id})"
      removed=$((removed + 1))
    fi
  done < <(docker images --format '{{.Repository}}:{{.Tag}}|{{.ID}}' 2>/dev/null)

  if [[ "${removed}" -eq 0 ]]; then
    log "No unused images removed."
  else
    log "Removed ${removed} unused image(s)."
  fi
}

cleanup() {
  rotate_log "${ORPHAN_LOG_RETENTION}"
  log "=== Orphan image cleanup started ==="
  [[ "${ORPHAN_DANGLING}" == "yes" ]] && cleanup_dangling
  [[ "${ORPHAN_UNUSED}"    == "yes" ]] && { log "Scanning for unused images..."; cleanup_unused; }
  docker builder prune -a -f >> "${LOG_FILE}" 2>&1 || :
  log "=== Orphan image cleanup completed ==="
  echo ""
}

cleanup
exit 0
]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  apply.sh - runs after settings are saved                     -->
<!-- ============================================================ -->
<FILE Name="&emhttpLOC;/apply.sh" Run="/bin/bash">
<INLINE><![CDATA[
#!/bin/bash
PLUGIN_NAME="orphan.images"
CFG_FILE="/boot/config/plugins/${PLUGIN_NAME}/${PLUGIN_NAME}.cfg"
SCRIPT="/usr/local/emhttp/plugins/${PLUGIN_NAME}/cleanup.sh"

[[ -f "${CFG_FILE}" ]] && source "${CFG_FILE}" || :

SCHED="${ORPHAN_SCHEDULE:-daily}"
CRON_STRING=""

case "${SCHED}" in
  hourly)  CRON_STRING="0 * * * *" ;;
  daily)   CRON_STRING="0 3 * * *" ;;
  weekly)  CRON_STRING="0 3 * * 0" ;;
  monthly) CRON_STRING="0 3 1 * *" ;;
  custom)  CRON_STRING="${ORPHAN_CRON_STRING}" ;;
  *)       CRON_STRING="" ;;
esac

rm -f /etc/cron.d/${PLUGIN_NAME} 2>/dev/null

if [[ -n "${CRON_STRING}" ]]; then
  echo "${CRON_STRING} root ${SCRIPT} >/dev/null 2>&1" > /etc/cron.d/${PLUGIN_NAME}
  /usr/bin/killall -HUP crond 2>/dev/null || :
  logger "${PLUGIN_NAME}: cron installed: ${CRON_STRING}"
else
  /usr/bin/killall -HUP crond 2>/dev/null || :
  logger "${PLUGIN_NAME}: cron removed (manual mode)"
fi

exit 0
]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  exec.php - AJAX endpoint for Run Now                         -->
<!-- ============================================================ -->
<FILE Name="&emhttpLOC;/exec.php">
<INLINE><![CDATA[<?PHP
$plugin = "orphan.images";
$action = $_POST['action'] ?? '';

switch ($action) {
  case 'run_now':
    $script = "/usr/local/emhttp/plugins/{$plugin}/cleanup.sh";
    exec("{$script} >/dev/null 2>&1 &");
    $msg = "Cleanup started.";
    break;
  default:
    $msg = "Unknown action.";
}

echo json_encode(['msg' => $msg]);
?>]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  orphan.images.page - Settings page                            -->
<!-- ============================================================ -->
<FILE Name="&emhttpLOC;/orphan.images.page">
<INLINE><![CDATA[Menu="Settings"
Title="Docker Orphan Cleaner"
Icon="trash"
---
<?PHP
$plugin = "orphan.images";
$cfg = parse_plugin_cfg($plugin);
?>

<script>
function toggleCronCustom() {
  var s = document.getElementById('ORPHAN_SCHEDULE').value;
  document.getElementById('cron_custom_row').style.display = (s === 'custom') ? '' : 'none';
}
function doRunNow() {
  document.getElementById('run_now_btn').disabled = true;
  document.getElementById('run_now_btn').value = 'Running...';
  $.post('/plugins/<?=$plugin?>/exec.php', {action: 'run_now'}, function() {
    document.getElementById('run_now_btn').disabled = false;
    document.getElementById('run_now_btn').value = 'Run Now';
  });
}
</script>

<form method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="csrf_token" value="<?=$var['csrf_token']?>">
<input type="hidden" name="#file" value="<?=$plugin?>/<?=$plugin?>.cfg">
<input type="hidden" name="#command" value="/usr/local/emhttp/plugins/<?=$plugin?>/apply.sh">

<fieldset class="settings">
<legend>Schedule</legend>

<dl>
<dt>Cleanup Frequency:</dt>
<dd>
<select name="ORPHAN_SCHEDULE" id="ORPHAN_SCHEDULE" onchange="toggleCronCustom()">
<option value="hourly"  <?=$cfg['ORPHAN_SCHEDULE']=='hourly'?'selected':''?>>Hourly</option>
<option value="daily"   <?=$cfg['ORPHAN_SCHEDULE']=='daily'?'selected':''?>>Daily (3:00 AM)</option>
<option value="weekly"  <?=$cfg['ORPHAN_SCHEDULE']=='weekly'?'selected':''?>>Weekly (Sun 3:00 AM)</option>
<option value="monthly" <?=$cfg['ORPHAN_SCHEDULE']=='monthly'?'selected':''?>>Monthly (1st 3:00 AM)</option>
<option value="manual"  <?=$cfg['ORPHAN_SCHEDULE']=='manual'?'selected':''?>>Manual only</option>
<option value="custom"  <?=$cfg['ORPHAN_SCHEDULE']=='custom'?'selected':''?>>Custom cron</option>
</select>
</dd>
</dl>

<dl id="cron_custom_row" style="<?=$cfg['ORPHAN_SCHEDULE']=='custom'?'':'display:none'?>">
<dt>Custom Cron:</dt>
<dd>
<input type="text" name="ORPHAN_CRON_STRING" value="<?=htmlspecialchars($cfg['ORPHAN_CRON_STRING'])?>" placeholder="0 4 * * *" size="25">
<span class="helptext">(minute hour day month weekday)</span>
</dd>
</dl>

</fieldset>

<fieldset class="settings">
<legend>Cleanup Options</legend>

<dl>
<dt>Remove dangling images:</dt>
<dd>
<select name="ORPHAN_DANGLING">
<option value="yes" <?=$cfg['ORPHAN_DANGLING']=='yes'?'selected':''?>>Yes</option>
<option value="no"  <?=$cfg['ORPHAN_DANGLING']=='no'?'selected':''?>>No</option>
</select>
<span class="helptext">&lt;none&gt;:&lt;none&gt; images with no tag</span>
</dd>
</dl>

<dl>
<dt>Remove unused images:</dt>
<dd>
<select name="ORPHAN_UNUSED">
<option value="yes" <?=$cfg['ORPHAN_UNUSED']=='yes'?'selected':''?>>Yes</option>
<option value="no"  <?=$cfg['ORPHAN_UNUSED']=='no'?'selected':''?>>No</option>
</select>
<span class="helptext">Images not used by any container</span>
</dd>
</dl>

<dl>
<dt>Preserve tagged images:</dt>
<dd>
<select name="ORPHAN_LEAVE_TAGGED">
<option value="yes" <?=$cfg['ORPHAN_LEAVE_TAGGED']=='yes'?'selected':''?>>Yes</option>
<option value="no"  <?=$cfg['ORPHAN_LEAVE_TAGGED']=='no'?'selected':''?>>No</option>
</select>
<span class="helptext">Skip images with a repo:tag</span>
</dd>
</dl>

<dl>
<dt>Force removal:</dt>
<dd>
<select name="ORPHAN_FORCE">
<option value="yes" <?=$cfg['ORPHAN_FORCE']=='yes'?'selected':''?>>Yes</option>
<option value="no"  <?=$cfg['ORPHAN_FORCE']=='no'?'selected':''?>>No</option>
</select>
<span class="helptext">Use docker rmi -f</span>
</dd>
</dl>

</fieldset>

<fieldset class="settings">
<legend>Logging</legend>

<dl>
<dt>Log retention:</dt>
<dd>
<select name="ORPHAN_LOG_RETENTION">
<? foreach ([1,3,7,14,30,0] as $d): ?>
<option value="<?=$d?>" <?=$cfg['ORPHAN_LOG_RETENTION']==(string)$d?'selected':''?>>
<?=$d===0?'Keep all':"{$d} days"?>
</option>
<? endforeach; ?>
</select>
</dd>
</dl>

</fieldset>

<dl>
<dt>&nbsp;</dt>
<dd>
<input type="submit" name="#apply" value="Apply" disabled>
<input type="button" value="Done" onclick="done()">
</dd>
</dl>
</form>

<dl>
<dt>Manual Run:</dt>
<dd>
<input type="button" id="run_now_btn" value="Run Now" onclick="doRunNow()">
</dd>
</dl>

<p><small>Log file: /var/log/orphan.images.log</small></p>
<?PHP ?>]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  Install script                                               -->
<!-- ============================================================ -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
mkdir -p /usr/local/emhttp/plugins/orphan.images
chmod +x /usr/local/emhttp/plugins/orphan.images/cleanup.sh /usr/local/emhttp/plugins/orphan.images/apply.sh 2>/dev/null
]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  Start script (runs on every boot)                            -->
<!-- ============================================================ -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
/usr/local/emhttp/plugins/orphan.images/apply.sh
]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  Stop script                                                  -->
<!-- ============================================================ -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
rm -f /etc/cron.d/orphan.images 2>/dev/null
/usr/bin/killall -HUP crond 2>/dev/null || :
]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  Upgrade script                                               -->
<!-- ============================================================ -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
mkdir -p /usr/local/emhttp/plugins/orphan.images
chmod +x /usr/local/emhttp/plugins/orphan.images/cleanup.sh /usr/local/emhttp/plugins/orphan.images/apply.sh 2>/dev/null
]]></INLINE>
</FILE>

<!-- ============================================================ -->
<!--  Remove script                                                -->
<!-- ============================================================ -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
rm -f /etc/cron.d/orphan.images 2>/dev/null
/usr/bin/killall -HUP crond 2>/dev/null || :
rm -rf /usr/local/emhttp/plugins/orphan.images 2>/dev/null
]]></INLINE>
</FILE>

</PLUGIN>
